# ============================================================
# AI-Tradmania Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Claude API (required for AI decisions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Exchange API Keys (optional — only needed for live trading)
BINANCE_API_KEY=
BINANCE_SECRET=
KRAKEN_API_KEY=
KRAKEN_SECRET=

# Trading Configuration
TARGET_SYMBOL=BTC/USDT          # Trading pair
TRADING_MODE=paper               # paper | live
INITIAL_BALANCE=10000            # Starting paper balance in USDT
MAX_POSITION_PCT=0.10            # Max 10% of portfolio per trade
STOP_LOSS_PCT=0.03               # 3% stop loss
TAKE_PROFIT_PCT=0.05             # 5% take profit
MAX_DAILY_DRAWDOWN_PCT=0.10      # Halt if daily loss > 10%
ANALYSIS_INTERVAL_SECONDS=30    # How often Claude analyzes (seconds)

# Exchanges to monitor (comma-separated, no spaces)
# Available: binance, kraken, bybit, coinbase, kucoin
EXCHANGES=binance,kraken,bybit

# Server
HOST=0.0.0.0
PORT=8000
